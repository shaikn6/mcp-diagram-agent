# ──────────────────────────────────────────────
# MCP Diagram Agent — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# Required: Anthropic API key
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Required for the REST API: shared secret for POST /generate auth.
# Send it as "Authorization: Bearer <key>" or "X-API-Key: <key>".
# If unset, POST /generate fails closed with HTTP 503.
MCP_API_KEY=choose-a-long-random-secret

# Optional: max POST /generate requests per minute, per API key (default 30)
MCP_RATE_LIMIT_PER_MIN=30

# Optional: Claude model to use (default shown)
CLAUDE_MODEL=claude-sonnet-4-5

# Optional: Server configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Optional: Hot-reload in development (set to "true")
RELOAD=false

# Optional: CORS allowed origins (comma-separated).
# Default is no cross-origin access; set origins explicitly to opt in.
CORS_ORIGINS=
